<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <!-- 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">
        <TextView
            android:fontFamily="@font/nanum_square_bold"
            android:id="@+id/tv_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📌투두리스트"
            android:textColor="#3D3185"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:fontFamily="@font/nanum_square_regular"
            android:id="@+id/tv_last_sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9E9BB8"
            android:textSize="9sp"
            android:layout_marginEnd="6dp" />
        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:text="&#8635;"
            android:textColor="#7B6FBE"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/btn_refresh_bg" />
    </LinearLayout>

    <!-- 2x2 그리드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 왼쪽: Q2(비긴급+중요) + Q4(비긴급+비중요) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="4dp">

            <LinearLayout
                android:id="@+id/q2_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/quadrant_bg_q2"
                android:padding="8dp"
                android:layout_marginBottom="4dp">
                <TextView
                    android:id="@+id/q2_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟡 중요+비긴급"
                    android:textColor="#E65100"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/nanum_square_bold"
                    android:layout_marginBottom="4dp" />
                <ListView
                    android:id="@+id/q2_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@null"
                    android:dividerHeight="0dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/q4_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/quadrant_bg_q4"
                android:padding="8dp">
                <TextView
                    android:id="@+id/q4_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔵 비중요+비긴급"
                    android:textColor="#1565C0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/nanum_square_bold"
                    android:layout_marginBottom="4dp" />
                <ListView
                    android:id="@+id/q4_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@null"
                    android:dividerHeight="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 오른쪽: Q1(긴급+중요) + Q3(긴급+비중요) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="4dp">

            <LinearLayout
                android:id="@+id/q1_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/quadrant_bg_q1"
                android:padding="8dp"
                android:layout_marginBottom="4dp">
                <TextView
                    android:id="@+id/q1_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 중요+긴급"
                    android:textColor="#B71C1C"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/nanum_square_bold"
                    android:layout_marginBottom="4dp" />
                <ListView
                    android:id="@+id/q1_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@null"
                    android:dividerHeight="0dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/q3_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/quadrant_bg_q3"
                android:padding="8dp">
                <TextView
                    android:id="@+id/q3_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 비중요+긴급"
                    android:textColor="#2E7D32"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/nanum_square_bold"
                    android:layout_marginBottom="4dp" />
                <ListView
                    android:id="@+id/q3_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@null"
                    android:dividerHeight="0dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
